{
  "name": "datasec",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-data-store.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:source": "node scripts/check-police-contract.mjs",
    "check:data": "node scripts/check-data-store.mjs",
    "check:method": "node --experimental-strip-types scripts/check-indicator-method.mjs",
    "check:place": "node scripts/check-place-evidence.cjs",
    "check:v2": "node scripts/check-product-v2.cjs",
    "check:report": "node scripts/check-location-report.cjs",
    "check:choice": "node scripts/check-address-choice.cjs",
    "check:context": "node scripts/check-place-context.cjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "6.0.2"
  }
}
